---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import DepartmentLogoManager from "@/components/departments/DepartmentLogoManager";
import AddEmployeeForm from "@/components/employees/AddEmployeeForm";
import EmployeeTable from "@/components/employees/EmployeeTable";
import { createClient } from "@/lib/supabase";
import { getDepartmentLogoUrl } from "@/lib/services/departments";
import { listEmployees } from "@/lib/services/employees";
import { isEmailDeliveryConfigured } from "@/lib/services/email-service";
import type { EmployeeDTO } from "@/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);

let employees: EmployeeDTO[] = [];
let initialLogoUrl: string | null = null;
let loadError: string | null = null;

if (supabase) {
  try {
    [employees, initialLogoUrl] = await Promise.all([listEmployees(supabase), getDepartmentLogoUrl(supabase)]);
  } catch {
    loadError = "Nie udało się wczytać listy pracowników. Spróbuj ponownie później.";
  }
}
---

<Layout title="Pracownicy">
  <div class="workspace-shell bg-brand text-foreground">
    <div class="workspace-container">
      <Topbar />
      <main class="py-6">
        <h1 class="mb-6 text-2xl font-bold text-foreground">Pracownicy</h1>

        <div class="grid items-start gap-6 xl:grid-cols-2">
          <DepartmentLogoManager initialLogoUrl={initialLogoUrl} client:load />
          <section
            class="min-w-0 rounded-lg border border-border bg-card p-4 sm:p-6"
            aria-labelledby="add-employee-heading"
          >
            <h2 id="add-employee-heading" class="mb-4 text-lg font-semibold">
              Dodaj pracownika
            </h2>
            <AddEmployeeForm client:load />
          </section>
        </div>

        <section class="mt-8 min-w-0 border-t border-border pt-6" aria-labelledby="employee-list-heading">
          <h2 id="employee-list-heading" class="mb-4 text-lg font-semibold">
            Lista pracowników
          </h2>
          {loadError ? (
            <p class="rounded-lg border border-destructive/30 bg-destructive/10 px-3 py-2 text-sm text-destructive">
              {loadError}
            </p>
          ) : employees.length === 0 ? (
            <p class="text-sm text-muted-foreground">
              Nie ma jeszcze pracowników. Dodaj pierwszą osobę w formularzu powyżej.
            </p>
          ) : (
            <EmployeeTable employees={employees} emailDeliveryEnabled={isEmailDeliveryConfigured()} client:load />
          )}
        </section>
      </main>
    </div>
  </div>
</Layout>
