---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { createClient } from "@/lib/supabase";

const errorCode = Astro.url.searchParams.get("error");
const errorMessages: Record<string, string> = {
  "Please select a department": "Wybierz dział.",
  "Supabase is not configured": "Rejestracja jest obecnie niedostępna. Spróbuj ponownie później.",
  "User already registered": "Konto z tym adresem e-mail już istnieje. Zaloguj się lub użyj innego adresu.",
  "Email rate limit exceeded": "Wysłano zbyt wiele próśb. Spróbuj ponownie później.",
  "Invalid email": "Wpisz prawidłowy adres e-mail.",
};
const error = errorCode ? (errorMessages[errorCode] ?? "Nie udało się utworzyć konta. Spróbuj ponownie.") : null;
interface DepartmentOption {
  id: string;
  name: string;
}

let departments: DepartmentOption[] = [];

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase) {
  const { data, error: departmentsError } = await supabase.from("departments").select("id, name").order("name");

  if (!departmentsError) {
    departments = data;
  }
}
---

<Layout title="Utwórz konto">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent">
        Utwórz konto
      </h1>
      <SignUpForm serverError={error} departments={departments} client:load />
      <p class="mt-4 text-center text-sm text-blue-100/60">
        Masz już konto?{" "}
        <a href="/auth/signin" class="text-primary hover:underline">
          Zaloguj się
        </a>
      </p>
    </div>
  </div>
</Layout>
