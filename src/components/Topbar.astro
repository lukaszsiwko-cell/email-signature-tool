---
const { user } = Astro.locals;
---

<div class="mb-4 flex items-center justify-between rounded-xl border border-border bg-card/60 px-4 py-2 text-sm text-foreground/80">
  {user ? (
    <>
      <span class="text-muted-foreground">{user.email}</span>
      <div class="flex items-center gap-3">
        <a href="/dashboard" class="text-primary transition-colors hover:text-primary/70 hover:underline">
          Dashboard
        </a>
        <a href="/employees" class="text-primary transition-colors hover:text-primary/70 hover:underline">
          Employees
        </a>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="text-primary transition-colors hover:text-primary/70 hover:underline">
            Sign out
          </button>
        </form>
      </div>
    </>
  ) : (
    <>
      <span class="text-muted-foreground">Not signed in</span>
      <div class="flex gap-3">
        <a href="/auth/signin" class="text-primary transition-colors hover:text-primary/70 hover:underline">
          Sign in
        </a>
        <a href="/auth/signup" class="text-primary transition-colors hover:text-primary/70 hover:underline">
          Sign up
        </a>
      </div>
    </>
  )}
</div>
