---
import { ArrowRight, Building2, Check, FileCode2, Mail, ShieldCheck, Users } from "lucide-react";
import Topbar from "@/components/Topbar.astro";

const { user } = Astro.locals;
---

{user ? (
  <div class="bg-brand min-h-screen w-full text-foreground">
    <div class="workspace-shell">
      <div class="workspace-container">
        <Topbar />
      </div>

      <main class="mx-auto grid max-w-6xl items-center gap-14 px-4 py-16 sm:py-24 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16 lg:py-28">
        <section>
          <p class="text-primary mb-4 flex items-center gap-2 text-xs font-semibold uppercase">
            <span class="size-2 rounded-full bg-primary"></span>
            Generator podpisów e-mail
          </p>
          <h1 class="mb-4 max-w-xl text-4xl leading-tight font-semibold text-foreground sm:text-5xl lg:text-6xl">
            Podpisy, które pasują do Twojego zespołu.
          </h1>
          <p class="max-w-lg text-base leading-relaxed text-muted-foreground sm:text-lg">
            Zarządzaj danymi pracowników, dodaj logo działu i przygotuj profesjonalne podpisy do każdej skrzynki.
          </p>

          <a
            href="/employees"
            class="mt-9 inline-flex min-h-12 items-center justify-center gap-2 rounded-md bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
          >
            <Users className="size-4" />
            Zarządzaj pracownikami
            <ArrowRight className="size-4" />
          </a>

          <div class="mt-8 flex max-w-md items-start gap-3 border-t border-border pt-5">
            <ShieldCheck className="text-primary mt-0.5 size-5 shrink-0" />
            <p class="text-sm leading-relaxed text-muted-foreground">
              Dane pracowników i pobrane podpisy są odseparowane dla każdego działu.
            </p>
          </div>
        </section>

        <section aria-label="Podgląd przykładowego podpisu e-mail" class="mx-auto w-full max-w-xl">
          <div class="overflow-hidden rounded-lg border border-white/15 bg-white shadow-2xl shadow-black/20">
            <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
              <div>
                <p class="text-xs font-semibold uppercase text-slate-500">Podgląd podpisu</p>
                <p class="mt-1 text-sm font-medium text-slate-900">Przykład</p>
              </div>
              <Mail className="size-5 text-emerald-700" />
            </div>

            <div class="p-6 sm:p-8">
              <div class="flex items-center gap-4">
                <div class="flex size-12 shrink-0 items-center justify-center rounded-md bg-emerald-50 text-emerald-800">
                  <FileCode2 className="size-6" />
                </div>
                <div>
                  <p class="text-lg font-semibold text-slate-950">Imię i nazwisko</p>
                  <p class="mt-0.5 text-sm text-slate-600">Stanowisko · Dział</p>
                </div>
              </div>
              <div class="mt-5 border-l-2 border-emerald-700 pl-4 text-sm leading-6 text-slate-600">
                <p>imie@firma.pl</p>
                <p>+48 500 000 000</p>
                <p class="font-medium text-emerald-800">firma.pl</p>
              </div>
            </div>

            <div class="border-t border-slate-200 bg-slate-50 px-5 py-4">
              <p class="mb-3 text-xs font-semibold uppercase text-slate-500">Gotowe do użycia</p>
              <div class="grid gap-2 sm:grid-cols-3">
                <div class="flex items-center gap-2 text-xs font-medium text-slate-700">
                  <FileCode2 className="size-4 text-emerald-700" /> HTML dla Outlooka
                </div>
                <div class="flex items-center gap-2 text-xs font-medium text-slate-700">
                  <Mail className="size-4 text-emerald-700" /> Konfiguracja Thunderbird
                </div>
                <div class="flex items-center gap-2 text-xs font-medium text-slate-700">
                  <ArrowRight className="size-4 text-emerald-700" /> Link jednorazowy
                </div>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>
  </div>
) : (
  <div class="bg-brand relative min-h-screen w-full overflow-hidden text-foreground">
    <div class="relative z-10 p-4 sm:p-8">
      <Topbar />

      <main class="mx-auto grid max-w-6xl items-center gap-14 px-4 py-16 sm:py-24 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16 lg:py-28">
        <section>
          <p class="mb-5 flex items-center gap-2 text-xs font-semibold uppercase text-emerald-300">
            <span class="size-2 rounded-full bg-emerald-400"></span>
            Firmowa komunikacja, jeden standard
          </p>
          <h1 class="max-w-xl text-4xl leading-tight font-semibold sm:text-5xl lg:text-6xl">
            Każdy e-mail zaczyna się od dobrego podpisu.
          </h1>
          <p class="mt-6 max-w-lg text-base leading-relaxed text-emerald-50/70 sm:text-lg">
            Przygotuj spójne podpisy dla całego zespołu. Dane pracowników, logo działu i gotowe pliki w jednym miejscu.
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a
              href="/auth/signup"
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-md bg-emerald-400 px-5 py-3 text-sm font-semibold text-[#10231d] transition-colors hover:bg-emerald-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-200"
            >
              Zacznij tworzyć podpisy
              <ArrowRight className="size-4" />
            </a>
            <a
              href="/auth/signin"
              class="inline-flex min-h-12 items-center justify-center rounded-md border border-white/20 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
            >
              Zaloguj się
            </a>
          </div>
          <p class="mt-5 flex items-center gap-2 text-sm text-emerald-50/55">
            <ShieldCheck className="size-4 text-emerald-300" />
            Dane każdego działu pozostają odseparowane.
          </p>
        </section>

        <section aria-label="Przykład wiadomości z podpisem e-mail" class="relative mx-auto w-full max-w-xl">
          <div class="absolute -inset-4 -z-10 rounded-2xl bg-emerald-400/10 blur-2xl"></div>
          <div class="overflow-hidden rounded-lg border border-white/15 bg-white text-slate-800 shadow-2xl shadow-black/30">
            <div class="flex items-center gap-2 border-b border-slate-200 bg-slate-50 px-5 py-4">
              <span class="size-2.5 rounded-full bg-rose-400"></span>
              <span class="size-2.5 rounded-full bg-amber-400"></span>
              <span class="size-2.5 rounded-full bg-emerald-500"></span>
              <div class="ml-3 flex min-w-0 flex-1 items-center gap-2 rounded-md bg-white px-3 py-2 text-xs text-slate-500">
                <Mail className="size-4 shrink-0 text-emerald-700" />
                <span class="truncate">Wiadomość · Odebrane</span>
              </div>
            </div>
            <div class="p-6 sm:p-8">
              <p class="text-xs font-semibold uppercase text-slate-400">Podgląd wiadomości</p>
              <p class="mt-5 text-sm font-semibold text-slate-900">Dziękuję za rozmowę</p>
              <p class="mt-1 text-xs text-slate-500">Do: Alex Morgan</p>
              <p class="mt-5 text-sm leading-relaxed text-slate-600">
                Cześć Alex, przesyłam szczegóły naszego spotkania. W razie pytań jestem do dyspozycji.
              </p>
              <div class="mt-7 border-t border-slate-200 pt-5">
                <div class="flex items-center gap-4">
                  <div class="flex size-12 shrink-0 items-center justify-center rounded-md bg-emerald-100 text-sm font-bold text-emerald-900">
                    AM
                  </div>
                  <div class="min-w-0">
                    <p class="font-semibold text-slate-950">Alex Morgan</p>
                    <p class="mt-0.5 text-sm text-slate-500">Customer Success · Northstar</p>
                  </div>
                  <div class="ml-auto hidden size-10 shrink-0 items-center justify-center rounded-md bg-emerald-800 text-white sm:flex">
                    <Building2 className="size-5" />
                  </div>
                </div>
                <div class="mt-4 border-l-2 border-emerald-700 pl-4 text-sm leading-6 text-slate-600">
                  <p>alex.morgan@northstar.example</p>
                  <p>+1 555 012 3400</p>
                  <p class="font-medium text-emerald-800">northstar.example</p>
                </div>
              </div>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 bg-slate-50 px-5 py-4">
              <span class="text-xs font-semibold uppercase text-slate-500">Gotowy do użycia</span>
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-emerald-800">
                <Check className="size-4" /> Outlook · Thunderbird
              </span>
            </div>
          </div>
        </section>
      </main>

      <div class="mx-auto grid max-w-6xl gap-6 border-t border-white/10 px-4 py-8 sm:grid-cols-3 sm:gap-8 sm:py-10">
        <div class="flex items-start gap-3">
          <Users className="mt-0.5 size-5 shrink-0 text-emerald-300" />
          <div>
            <h2 class="text-sm font-semibold text-white">Zespół w jednym miejscu</h2>
            <p class="mt-1 text-sm leading-relaxed text-emerald-50/55">Zarządzaj danymi pracowników i działów.</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <Building2 className="mt-0.5 size-5 shrink-0 text-emerald-300" />
          <div>
            <h2 class="text-sm font-semibold text-white">Spójny wizerunek</h2>
            <p class="mt-1 text-sm leading-relaxed text-emerald-50/55">Dodaj logo i ujednolić komunikację marki.</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <FileCode2 className="mt-0.5 size-5 shrink-0 text-emerald-300" />
          <div>
            <h2 class="text-sm font-semibold text-white">Eksport bez kombinowania</h2>
            <p class="mt-1 text-sm leading-relaxed text-emerald-50/55">
              Przygotuj formaty do popularnych klientów poczty.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
)}
