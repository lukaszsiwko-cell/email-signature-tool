		{
			"label": "Verify expired signature token behavior",
			"type": "shell",
			"command": "npx.cmd",
			"args": [
				"supabase",
				"db",
				"query",
				"--local",
				"do $body$ declare test_employee public.employees%rowtype; test_hash text := repeat(md5(random()::text), 2); begin select * into test_employee from public.employees limit 1; if test_employee.id is null then raise exception 'no local employee available for expiry check'; end if; insert into public.signature_deliveries (department_id, employee_id, token_hash, artifact_bundle, expires_at) values (test_employee.department_id, test_employee.id, test_hash, jsonb_build_object($value$outlookHtml$value$, $value$expired-test$value$, $value$thunderbirdInstaller$value$, $value$expired-test$value$, $value$thunderbirdLauncher$value$, $value$expired-test$value$), now() - interval $value$1 minute$value$); if public.redeem_signature_delivery(test_hash) is not null then raise exception 'expired token was redeemed'; end if; delete from public.signature_deliveries where token_hash = test_hash; end $body$;"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify expired delivery redemption path",
			"type": "shell",
			"command": "npx.cmd",
			"args": [
				"supabase",
				"db",
				"query",
				"--local",
				"do $body$ declare test_employee public.employees%rowtype; test_hash text := repeat(md5(random()::text), 2); begin select * into test_employee from public.employees limit 1; if test_employee.id is null then return; end if; insert into public.signature_deliveries (department_id, employee_id, token_hash, artifact_bundle, expires_at) values (test_employee.department_id, test_employee.id, test_hash, jsonb_build_object($value$outlookHtml$value$, $value$expired-test$value$, $value$thunderbirdInstaller$value$, $value$expired-test$value$, $value$thunderbirdLauncher$value$, $value$expired-test$value$), now() - interval $value$1 minute$value$); if public.redeem_signature_delivery(test_hash) is not null then raise exception $value$expired token redeemed$value$; end if; delete from public.signature_deliveries where token_hash = test_hash; end $body$;"
			],
			"isBackground": false,
			"problemMatcher": []
		},
